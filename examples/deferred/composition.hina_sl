/**
 * Deferred Composition Shader
 *
 * Reads the G-buffer textures and performs lighting calculations
 * using an SSBO for light data.
 * Based on Sascha Willems' subpasses example.
 */

#hina
group Scene = 0;
group GBuffer = 1;

// Light structure (must match C++ Light struct)
struct Light {
  vec4 position;  // xyz = position, w = unused
  vec4 color;     // xyz = color, w = radius
};

bindings(Scene, start=0) {
  uniform(std140) CompositionUBO {
    vec4 view_pos;
    uint light_count;
    uint _pad[3];
  } ubo;
  buffer(readonly) LightSSBO {
    Light lights[];
  } light_ssbo;
}

bindings(GBuffer, start=0) {
  texture sampler2D u_position;
  texture sampler2D u_normal;
  texture sampler2D u_albedo;
}

struct Varyings {
  vec2 uv;
};

struct FragOut {
  vec4 color;
};
#hina_end

#hina_stage vertex entry VSMain
Varyings VSMain() {
    Varyings out;
    // Full-screen triangle from vertex ID
    out.uv = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
    gl_Position = vec4(out.uv * 2.0 - 1.0, 0.0, 1.0);
    return out;
}
#hina_end

#hina_stage fragment entry FSMain
FragOut FSMain(Varyings in) {
    FragOut out;

    // Sample G-buffer
    vec4 pos_sample = texture(u_position, in.uv);
    vec4 norm_sample = texture(u_normal, in.uv);
    vec4 albedo_sample = texture(u_albedo, in.uv);

    vec3 frag_pos = pos_sample.rgb;
    vec3 normal = normalize(norm_sample.rgb);
    vec3 albedo = albedo_sample.rgb;
    float emissive = norm_sample.a;

    // Background check
    if (pos_sample.a < 0.5) {
        out.color = vec4(vec3(0.0), 1.0);
        return out;
    }

    // Emissive geometry - output the albedo color directly (bright)
    if (emissive > 0.5) {
        out.color = vec4(albedo, 1.0);
        return out;
    }

    // Ambient
    vec3 frag_color = albedo * 0.05;

    // View direction for specular
    vec3 V = normalize(ubo.view_pos.xyz - frag_pos);

    // Point lights (Sascha Willems style attenuation)
    for (uint i = 0u; i < ubo.light_count; i++) {
        vec3 L = light_ssbo.lights[i].position.xyz - frag_pos;
        float dist = length(L);
        L = normalize(L);

        float radius = light_ssbo.lights[i].color.w;

        // Sascha Willems attenuation: radius / (dist^3 + 1)
        float atten = radius / (pow(dist, 3.0) + 1.0);

        // Diffuse (Lambert)
        float NdotL = max(0.0, dot(normal, L));
        vec3 diff = light_ssbo.lights[i].color.rgb * albedo * NdotL * atten;

        // Specular (Phong reflection)
        vec3 R = reflect(-L, normal);
        float RdotV = max(0.0, dot(R, V));
        float spec = pow(RdotV, 16.0);
        vec3 specular = light_ssbo.lights[i].color.rgb * spec * atten * 0.2;

        frag_color += diff + specular;
    }

    out.color = vec4(frag_color, 1.0);
    return out;
}
#hina_end
