/**
 * Transparent Forward Pass Shader
 *
 * Renders transparent geometry (glass) after the deferred composition pass.
 * Uses depth from G-buffer to properly occlude transparent surfaces behind
 * opaque geometry.
 */

#hina
group Scene = 0;

bindings(Scene, start=0) {
  uniform(std140) TransparentUBO {
    mat4 projection;
    mat4 view;
    mat4 model;
    uint depth_tex_id;
    float near_plane;
    float far_plane;
    uint _pad;
  } ubo;
}

struct VertexIn {
  vec3 a_position;
  vec3 a_normal;
  vec4 a_color;
  vec2 a_uv;
};

struct Varyings {
  vec4 color;
  vec2 uv;
  vec3 world_pos;
  vec3 normal;
};

struct FragOut {
  vec4 color;
};
#hina_end

#hina_stage vertex entry VSMain
Varyings VSMain(VertexIn in) {
    Varyings out;

    vec4 world_pos = ubo.model * vec4(in.a_position, 1.0);
    out.world_pos = world_pos.xyz;
    out.color = in.a_color;
    out.uv = in.a_uv;

    mat3 normal_matrix = transpose(inverse(mat3(ubo.model)));
    out.normal = normalize(normal_matrix * in.a_normal);

    gl_Position = ubo.projection * ubo.view * world_pos;
    return out;
}
#hina_end

#hina_stage fragment entry FSMain
FragOut FSMain(Varyings in) {
    FragOut out;

    // Simple glass shading - just use vertex color with alpha
    // Add some fake specular/fresnel effect based on view angle
    vec3 view_dir = normalize(-in.world_pos);  // Approximate view direction
    vec3 normal = normalize(in.normal);

    float fresnel = pow(1.0 - abs(dot(view_dir, normal)), 2.0);

    vec3 glass_color = in.color.rgb + vec3(fresnel * 0.3);
    float alpha = in.color.a + fresnel * 0.2;

    out.color = vec4(glass_color, alpha);
    return out;
}
#hina_end
