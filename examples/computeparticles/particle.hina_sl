/**
 * Particle Rendering Shader
 *
 * Renders particles from the compute shader output.
 * No descriptor bindings - all data comes from vertex attributes
 * (filled by compute shader).
 *
 * Based on Sascha Willems' computeparticles shaders.
 */

#hina
struct VertexIn {
  vec2 a_pos;
  vec2 a_vel;
  vec4 a_gradientPos;  // x = random hue
};

struct Varyings {
  float speed;
  float hue;
};

struct FragOut {
  vec4 color;
};
#hina_end

#hina_stage vertex entry VSMain
Varyings VSMain(VertexIn in) {
    Varyings out;
    gl_PointSize = 8.0;
    out.speed = length(in.a_vel);
    out.hue = in.a_gradientPos.x;
    gl_Position = vec4(in.a_pos.xy, 1.0, 1.0);
    return out;
}
#hina_end

#hina_stage fragment entry FSMain
// Convert HSV to RGB
vec3 hsv2rgb(vec3 c) {
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

FragOut FSMain(Varyings in) {
    FragOut out;

    // Normalize speed for brightness modulation
    float normalizedSpeed = clamp(in.speed * 10.0, 0.0, 1.0);

    // Per-particle random hue (full rainbow)
    float hue = in.hue;

    // Keep saturation high always to preserve color
    float saturation = 1.0;

    // Lower overall brightness to prevent white saturation with additive blending
    // Slow particles are very dim, fast particles are moderately bright
    float value = mix(0.08, 0.35, normalizedSpeed);

    vec3 color = hsv2rgb(vec3(hue, saturation, value));

    // Procedural particle texture (soft circular gradient)
    vec2 coord = gl_PointCoord * 2.0 - 1.0;
    float dist = length(coord);
    float particleAlpha = 1.0 - smoothstep(0.0, 1.0, dist);

    out.color.rgb = particleAlpha * color;
    out.color.a = 1.0;
    return out;
}
#hina_end
