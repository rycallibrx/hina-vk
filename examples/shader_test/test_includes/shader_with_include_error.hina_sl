// Shader with intentional GLSL error to test error reporting

#hina
struct VertexIn {
  vec3 a_position;
};

struct Varyings {
  vec3 color;
};

struct FragOut {
  vec4 color;
};
#hina_end

#hina_stage vertex entry VSMain
Varyings VSMain(VertexIn in) {
    Varyings out;
    gl_Position = vec4(in.a_position  // Missing closing paren - GLSL error!
    return out;
}
#hina_end

#hina_stage fragment entry FSMain
FragOut FSMain(Varyings in) {
    FragOut out;
    out.color = vec4(1.0);
    return out;
}
#hina_end
