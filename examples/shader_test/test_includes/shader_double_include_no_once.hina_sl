// Double include WITHOUT guard - should fail with redefinition

#hina
struct VertexIn {
  vec3 a_position;
};

struct Varyings {
  vec2 uv;
};

struct FragOut {
  vec4 color;
};
#hina_end

#hina_stage vertex entry VSMain
#include "shared_types_no_guard.glsl"
#include "shared_types_no_guard.glsl"
Varyings VSMain(VertexIn in) {
    Varyings out;
    gl_Position = ubo.data.mvp * vec4(in.a_position, 1.0);
    out.uv = vec2(0.0);
    return out;
}
#hina_end

#hina_stage fragment entry FSMain
FragOut FSMain(Varyings in) {
    FragOut out;
    out.color = vec4(1.0);
    return out;
}
#hina_end
