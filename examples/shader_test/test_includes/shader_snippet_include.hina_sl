// Test: shared snippet library included into #hina block
// Demonstrates cross-file snippet sharing via #include

#hina
#include "snippet_library.glsl"

struct VertexIn {
  vec3 a_position;
  vec3 a_normal;
};

struct Varyings {
  vec3 normal;
};

struct FragOut {
  vec4 color;
};
#hina_end

#hina_stage vertex entry VSMain
layout(set = 0, binding = 0) uniform UBO { mat4 mvp; } ubo;
Varyings VSMain(VertexIn in) {
    Varyings out;
    gl_Position = ubo.mvp * vec4(in.a_position, 1.0);
    out.normal = in.a_normal;
    return out;
}
#hina_end

#hina_stage fragment entry FSMain use lighting
FragOut FSMain(Varyings in) {
    FragOut out;
    vec3 light_dir = normalize(vec3(1.0, 1.0, 1.0));
    vec3 diffuse = calc_diffuse(normalize(in.normal), light_dir, vec3(1.0));
    out.color = vec4(diffuse, 1.0);
    return out;
}
#hina_end
