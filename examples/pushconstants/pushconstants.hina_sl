/**
 * Push Constants shader
 * Based on Sascha Willems' pushconstants example
 *
 * Demonstrates using push constants to pass per-object data (color and position)
 * directly to the shader without requiring descriptor sets.
 *
 * Push constants are ideal for small, frequently changing data that varies
 * per draw call.
 */

#hina
group Scene = 0;

bindings(Scene, start=0) {
  uniform(std140) UBO {
    mat4 projection;
    mat4 view;
    mat4 model;
  } ubo;
}

push_constant PushConstants {
  vec4 color;
  vec4 position;
} pushConstants;

struct VertexIn {
  vec3 a_position;
  vec3 a_normal;
  vec3 a_color;
};

struct Varyings {
  vec3 normal;
  vec3 color;
  vec3 view_pos;
  vec3 light_pos;
};

struct FragOut {
  vec4 color;
};
#hina_end

#hina_stage vertex entry VSMain
Varyings VSMain(VertexIn in) {
    Varyings out;

    // Apply sphere position offset from push constants
    vec4 world_pos = ubo.model * vec4(in.a_position + pushConstants.position.xyz, 1.0);

    // Transform to clip space
    gl_Position = ubo.projection * ubo.view * world_pos;

    // Pass color from push constants (modulated by vertex color)
    out.color = pushConstants.color.rgb * in.a_color;

    // Transform normal for lighting
    out.normal = mat3(ubo.model) * in.a_normal;

    // View space position for lighting
    out.view_pos = (ubo.view * world_pos).xyz;

    // Light position (fixed in world space, above and in front)
    vec4 light_world = vec4(0.0, 0.0, 5.0, 1.0);
    out.light_pos = (ubo.view * light_world).xyz;
    return out;
}
#hina_end

#hina_stage fragment entry FSMain
FragOut FSMain(Varyings in) {
    FragOut out;

    // Simple Blinn-Phong lighting
    vec3 N = normalize(in.normal);
    vec3 L = normalize(in.light_pos - in.view_pos);
    vec3 V = normalize(-in.view_pos);
    vec3 H = normalize(L + V);

    // Ambient
    vec3 ambient = 0.2 * in.color;

    // Diffuse
    float diff = max(dot(N, L), 0.0);
    vec3 diffuse = diff * in.color;

    // Specular
    float spec = pow(max(dot(N, H), 0.0), 32.0);
    vec3 specular = vec3(0.3) * spec;

    out.color = vec4(ambient + diffuse + specular, 1.0);
    return out;
}
#hina_end
