/**
 * Phong Shading Shader
 *
 * Standard phong shading for rendering the 3D model.
 * Used for both offscreen (mirrored) and normal rendering.
 */

#hina
group Scene = 0;

bindings(Scene, start=0) {
  uniform(std140) UBO {
    mat4 projection;
    mat4 view;
    mat4 model;
    vec4 light_pos;
  } ubo;
}

struct VertexIn {
  vec3 a_position;
  vec3 a_normal;
  vec3 a_color;
};

struct Varyings {
  vec3 normal;
  vec3 color;
  vec3 view_vec;
  vec3 light_vec;
};

struct FragOut {
  vec4 color;
};
#hina_end

#hina_stage vertex entry VSMain
Varyings VSMain(VertexIn in) {
    Varyings out;

    out.color = in.a_color;

    mat3 normal_matrix = transpose(inverse(mat3(ubo.model)));
    out.normal = normalize(normal_matrix * in.a_normal);

    vec4 world_pos = ubo.model * vec4(in.a_position, 1.0);
    gl_Position = ubo.projection * ubo.view * world_pos;

    // Calculate view and light vectors
    vec4 pos_in_view = ubo.view * world_pos;
    out.light_vec = normalize(ubo.light_pos.xyz - world_pos.xyz);
    out.view_vec = -pos_in_view.xyz;
    return out;
}
#hina_end

#hina_stage fragment entry FSMain
FragOut FSMain(Varyings in) {
    FragOut out;

    vec3 N = normalize(in.normal);
    vec3 L = normalize(in.light_vec);
    vec3 V = normalize(in.view_vec);
    vec3 R = reflect(-L, N);

    // Ambient
    vec3 ambient = 0.1 * in.color;

    // Diffuse (N dot L)
    float NdotL = dot(N, L);
    float diff = max(NdotL, 0.0);
    vec3 diffuse = diff * in.color;

    // Specular - only on surfaces facing the light (NdotL > 0)
    float spec = 0.0;
    if (NdotL > 0.0) {
        spec = pow(max(dot(R, V), 0.0), 32.0);
    }
    vec3 specular = vec3(0.5) * spec;

    out.color = vec4(ambient + diffuse + specular, 1.0);
    return out;
}
#hina_end
