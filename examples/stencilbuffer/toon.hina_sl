/**
 * Toon Shading Shader
 * Renders the model with cel-shading style lighting and writes to stencil buffer
 *
 * Based on Sascha Willems stencilbuffer example
 */

#hina
group Scene = 0;

bindings(Scene, start=0) {
  uniform(std140) UBO {
    mat4 projection;
    mat4 model;
    vec4 light_pos;
    float outline_width;
    float _pad[3];
  } ubo;
}

struct VertexIn {
  vec3 a_position;
  vec3 a_normal;
};

struct Varyings {
  vec3 normal;
  vec3 color;
  vec3 light_vec;
};

struct FragOut {
  vec4 color;
};
#hina_end

#hina_stage vertex entry VSMain
Varyings VSMain(VertexIn in) {
    Varyings out;

    // Output a red base color for toon shading
    out.color = vec3(1.0, 0.0, 0.0);

    gl_Position = ubo.projection * ubo.model * vec4(in.a_position, 1.0);

    // Transform normal to world space
    out.normal = mat3(ubo.model) * in.a_normal;

    // Calculate light vector in world space
    vec4 world_pos = ubo.model * vec4(in.a_position, 1.0);
    vec3 light_pos_world = mat3(ubo.model) * ubo.light_pos.xyz;
    out.light_vec = light_pos_world - world_pos.xyz;
    return out;
}
#hina_end

#hina_stage fragment entry FSMain
FragOut FSMain(Varyings in) {
    FragOut out;

    vec3 color;
    vec3 N = normalize(in.normal);
    vec3 L = normalize(in.light_vec);

    // Cel-shading: quantize lighting intensity into bands
    float intensity = dot(N, L);

    if (intensity > 0.98)
        color = in.color * 1.5;
    else if (intensity > 0.9)
        color = in.color * 1.0;
    else if (intensity > 0.5)
        color = in.color * 0.6;
    else if (intensity > 0.25)
        color = in.color * 0.4;
    else
        color = in.color * 0.2;

    // Desaturate slightly for a more stylized look
    float luminance = dot(vec3(0.2126, 0.7152, 0.0722), color);
    color = mix(color, vec3(luminance), 0.1);

    out.color = vec4(color, 1.0);
    return out;
}
#hina_end
