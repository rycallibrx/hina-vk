/**
 * Phong shading pipeline
 * Standard Blinn-Phong lighting model
 */

#hina
group Scene = 0;

bindings(Scene, start=0) {
  uniform(std140) UBO {
    mat4 projection;
    mat4 model;
    mat4 view;
    vec4 light_pos;
  } ubo;
}

struct VertexIn {
  vec3 a_position;
  vec3 a_normal;
  vec3 a_color;
};

struct Varyings {
  vec3 normal;
  vec3 color;
  vec3 view_vec;
  vec3 light_vec;
};

struct FragOut {
  vec4 color;
};
#hina_end

#hina_stage vertex entry VSMain
Varyings VSMain(VertexIn in) {
    Varyings out;

    mat4 model_view = ubo.view * ubo.model;
    vec4 world_pos = model_view * vec4(in.a_position, 1.0);

    gl_Position = ubo.projection * world_pos;

    // Transform normal to view space
    mat3 normal_matrix = transpose(inverse(mat3(model_view)));
    out.normal = normalize(normal_matrix * in.a_normal);

    out.color = in.a_color;

    // View space light calculations
    vec3 light_pos_view = (ubo.view * ubo.light_pos).xyz;
    out.light_vec = light_pos_view - world_pos.xyz;
    out.view_vec = -world_pos.xyz;
    return out;
}
#hina_end

#hina_stage fragment entry FSMain
FragOut FSMain(Varyings in) {
    FragOut out;

    vec3 N = normalize(in.normal);
    vec3 L = normalize(in.light_vec);
    vec3 V = normalize(in.view_vec);
    vec3 H = normalize(L + V);

    // Ambient
    vec3 ambient = 0.1 * in.color;

    // Diffuse
    float diff = max(dot(N, L), 0.0);
    vec3 diffuse = diff * in.color;

    // Specular (Blinn-Phong)
    float spec = pow(max(dot(N, H), 0.0), 32.0);
    vec3 specular = vec3(0.5) * spec;

    out.color = vec4(ambient + diffuse + specular, 1.0);
    return out;
}
#hina_end
