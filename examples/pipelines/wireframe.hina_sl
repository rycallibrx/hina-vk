/**
 * Wireframe pipeline
 * Simple solid color for wireframe rendering
 */

#hina
group Scene = 0;

bindings(Scene, start=0) {
  uniform(std140) UBO {
    mat4 projection;
    mat4 model;
    mat4 view;
    vec4 light_pos;
  } ubo;
}

struct VertexIn {
  vec3 a_position;
  vec3 a_normal;
  vec3 a_color;
};

struct Varyings {
  vec3 color;
};

struct FragOut {
  vec4 color;
};
#hina_end

#hina_stage vertex entry VSMain
Varyings VSMain(VertexIn in) {
    Varyings out;
    gl_Position = ubo.projection * ubo.view * ubo.model * vec4(in.a_position, 1.0);
    out.color = in.a_color;
    return out;
}
#hina_end

#hina_stage fragment entry FSMain
FragOut FSMain(Varyings in) {
    FragOut out;
    // Simple wireframe color with slight tint
    out.color = vec4(in.color * 0.8 + 0.2, 1.0);
    return out;
}
#hina_end
