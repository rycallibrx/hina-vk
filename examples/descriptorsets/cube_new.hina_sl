/**
 * Textured Cube Shader (New HSL Syntax)
 *
 * Renders a textured cube with basic lighting.
 * Based on Sascha Willems' descriptor sets example.
 */

#hina
// Define bind groups
group Transforms = 0;
group Material = 1;

// Bind group 0: Transforms
bindings(Transforms, start=0) {
  uniform(std140) UBO {
    mat4 projection;
    mat4 view;
    mat4 model;
    vec4 light_pos;
  } ubo;
}

// Bind group 1: Material texture
bindings(Material, start=0) {
  texture sampler2D u_texture;
}

// Vertex input struct
struct VertexIn {
  vec3 a_position;
  vec3 a_normal;
  vec2 a_uv;
};

// Varyings: vertex-to-fragment interpolated data
struct Varyings {
  vec2 uv;
  vec3 normal;
  vec3 view_vec;
  vec3 light_vec;
};

// Fragment output
struct FragOut {
  vec4 color;
};
#hina_end

#hina_stage vertex entry VSMain
Varyings VSMain(VertexIn in) {
  Varyings out;
  out.uv = in.a_uv;

  vec4 world_pos = ubo.model * vec4(in.a_position, 1.0);
  gl_Position = ubo.projection * ubo.view * world_pos;

  out.normal = mat3(ubo.model) * in.a_normal;
  out.light_vec = ubo.light_pos.xyz - world_pos.xyz;
  out.view_vec = -world_pos.xyz;
  return out;
}
#hina_end

#hina_stage fragment entry FSMain
FragOut FSMain(Varyings in) {
  FragOut out;
  vec4 tex_color = texture(u_texture, in.uv);

  vec3 N = normalize(in.normal);
  vec3 L = normalize(in.light_vec);
  vec3 V = normalize(in.view_vec);
  vec3 R = reflect(-L, N);

  // Ambient
  vec3 ambient = vec3(0.1) * tex_color.rgb;

  // Diffuse
  float diff = max(dot(N, L), 0.0);
  vec3 diffuse = diff * tex_color.rgb;

  // Specular
  float spec = pow(max(dot(R, V), 0.0), 32.0);
  vec3 specular = vec3(0.5) * spec;

  out.color = vec4(ambient + diffuse + specular, 1.0);
  return out;
}
#hina_end
