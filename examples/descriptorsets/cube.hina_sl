/**
 * Textured Cube Shader
 *
 * Renders a textured cube with basic lighting.
 * Based on Sascha Willems' descriptor sets example.
 */

#hina
group Transforms = 0;
group Material = 1;

bindings(Transforms, start=0) {
  uniform(std140) UBO {
    mat4 projection;
    mat4 view;
    mat4 model;
    vec4 light_pos;
  } ubo;
}

bindings(Material, start=0) {
  texture sampler2D u_texture;
}

struct VertexIn {
  vec3 a_position;
  vec3 a_normal;
  vec2 a_uv;
};

struct Varyings {
  vec2 uv;
  vec3 normal;
  vec3 view_vec;
  vec3 light_vec;
};

struct FragOut {
  vec4 color;
};
#hina_end

#hina_stage vertex entry VSMain
Varyings VSMain(VertexIn in) {
    Varyings out;
    out.uv = in.a_uv;

    // Transform to view space (matches pipelines/phong.hina_sl approach)
    mat4 model_view = ubo.view * ubo.model;
    vec4 view_pos = model_view * vec4(in.a_position, 1.0);
    gl_Position = ubo.projection * view_pos;

    // Normal in view space
    mat3 normal_matrix = mat3(model_view);
    out.normal = normalize(normal_matrix * in.a_normal);

    // Light position in view space
    vec3 light_pos_view = (ubo.view * ubo.light_pos).xyz;
    out.light_vec = light_pos_view - view_pos.xyz;

    // View vector: camera is at origin in view space
    out.view_vec = -view_pos.xyz;
    return out;
}
#hina_end

#hina_stage fragment entry FSMain
FragOut FSMain(Varyings in) {
    FragOut out;
    vec4 tex_color = texture(u_texture, in.uv);

    vec3 N = normalize(in.normal);
    vec3 L = normalize(in.light_vec);
    vec3 V = normalize(in.view_vec);
    vec3 R = reflect(-L, N);

    // Ambient
    vec3 ambient = vec3(0.1) * tex_color.rgb;

    // Diffuse
    float diff = max(dot(N, L), 0.0);
    vec3 diffuse = diff * tex_color.rgb;

    // Specular
    float spec = pow(max(dot(R, V), 0.0), 32.0);
    vec3 specular = vec3(0.5) * spec;

    out.color = vec4(ambient + diffuse + specular, 1.0);
    return out;
}
#hina_end
