/**
 * Triangle shader - HinaVK Example
 * Renders a colored triangle with MVP transformation
 */

#hina
group Scene = 0;

bindings(Scene, start=0) {
  uniform(std140) UBO {
    mat4 projection;
    mat4 model;
    mat4 view;
  } ubo;
}

struct VertexIn {
  vec3 a_position;
  vec3 a_color;
};

struct Varyings {
  vec3 color;
};

struct FragOut {
  vec4 color;
};
#hina_end

#hina_stage vertex entry VSMain
Varyings VSMain(VertexIn in) {
    Varyings out;
    out.color = in.a_color;
    gl_Position = ubo.projection * ubo.view * ubo.model * vec4(in.a_position, 1.0);
    return out;
}
#hina_end

#hina_stage fragment entry FSMain
FragOut FSMain(Varyings in) {
    FragOut out;
    out.color = vec4(in.color, 1.0);
    return out;
}
#hina_end
