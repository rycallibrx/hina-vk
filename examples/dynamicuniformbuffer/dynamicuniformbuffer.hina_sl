/**
 * Dynamic Uniform Buffer shader
 * Based on Sascha Willems' dynamicuniformbuffer example
 *
 * Uses two uniform buffers:
 * - Binding 0: View/Projection (shared across all objects)
 * - Binding 1: Model matrix (bound with dynamic offset per object)
 */

#hina
group Scene = 0;

bindings(Scene, start=0) {
  uniform(std140) ViewProjectionUBO {
    mat4 projection;
    mat4 view;
  } vp;
  uniform(std140) ModelUBO {
    mat4 model;
  } model;
}

struct VertexIn {
  vec3 a_position;
  vec3 a_color;
};

struct Varyings {
  vec3 color;
};

struct FragOut {
  vec4 color;
};
#hina_end

#hina_stage vertex entry VSMain
Varyings VSMain(VertexIn in) {
    Varyings out;
    out.color = in.a_color;
    gl_Position = vp.projection * vp.view * model.model * vec4(in.a_position, 1.0);
    return out;
}
#hina_end

#hina_stage fragment entry FSMain
FragOut FSMain(Varyings in) {
    FragOut out;
    out.color = vec4(in.color, 1.0);
    return out;
}
#hina_end
